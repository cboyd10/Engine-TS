<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>World Map</title>
<link rel="stylesheet" href="/website/theme.css">
</head>
<body bgcolor="black" text="white" link="#90c040" alink="#90c040" vlink="#90c040" style="margin:0px">

<%- include('partials/frame-header') %>

<table width="300" bgcolor="black" cellpadding="4"><tbody><tr><td class="e"><center>
<b>World Map</b><br><a href="/" class="c">Main menu</a>
</center></td></tr></tbody></table>

<br>
<table width="940" bgcolor="black" cellpadding="10"><tbody><tr><td class="e">
<center>
<p style="margin: 0 0 10px;">
    <% if (highlight) { %>
        Highlighting (<%= highlight.x %>, <%= highlight.z %>). Drag to pan, use the zoom buttons in the bottom-left to zoom.
    <% } else { %>
        Drag to pan, use the zoom buttons in the bottom-left to zoom.
    <% } %>
    &middot; <a href="/items" class="c">Back to item search</a>
</p>
<canvas id="canvas" width="900" height="600"></canvas>
</center>
</td></tr></tbody></table>
<br>

<%- include('partials/frame-footer') %>

<script type="module">
    import { MapView } from '/mapview/mapview.js';

    const highlight = <%- JSON.stringify(highlight) %>;
    const mapView = new MapView();

    const waitForLoad = setInterval(() => {
        if (mapView.loaded) {
            clearInterval(waitForLoad);
            if (highlight) {
                mapView.setMarkers([highlight], []);
                mapView.centerOn(highlight.x, highlight.z);
            }
        }
    }, 100);
</script>
</body>
</html>
