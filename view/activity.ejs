<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Activity Feed</title>
    <style>
        :root {
            --root-bg: #1b1d19;
            --color-base-100: #131512;
            --color-base-200: #1b1d19;
            --color-primary: #2d322a;
            --color-primary-content: #e6e3d5;
            --color-accent: #c9a86a;
            --color-siam-300: #a3aa9e;
            --color-siam-700: #41473e;

            --bg: var(--root-bg);
            --surface: var(--color-base-100);
            --text: var(--color-primary-content);
            --muted: var(--color-siam-300);
            --accent: var(--color-accent);
            --border: var(--color-siam-700);
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            background: var(--bg);
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, sans-serif;
            color: var(--text);
            background: var(--bg);
        }

        main {
            max-width: 900px;
            margin: 0 auto;
            padding: 24px 16px 64px;
        }

        h1 {
            color: var(--accent);
            font-size: 22px;
            margin-bottom: 4px;
        }

        p.subtitle {
            color: var(--muted);
            margin-top: 0;
            margin-bottom: 24px;
        }

        ul {
            list-style: none;
            margin: 0;
            padding: 0;
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow: hidden;
            background: var(--surface);
        }

        li {
            padding: 8px 14px;
            border-top: 1px solid var(--border);
            font-size: 13px;
        }

        li:first-child {
            border-top: none;
        }

        li:nth-child(even) {
            background: rgba(255, 255, 255, 0.02);
        }

        .timestamp {
            color: var(--muted);
            margin-right: 10px;
            font-variant-numeric: tabular-nums;
        }

        p.empty {
            color: var(--muted);
            padding: 14px;
            margin: 0;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: var(--surface);
        }
    </style>
</head>
<body>
    <main>
        <h1>Activity Feed</h1>
        <p class="subtitle">Recent quest completions and other adventures, most recent first.</p>

        <% if (logs.length === 0) { %>
            <p class="empty">No activity yet.</p>
        <% } else { %>
            <ul>
                <% logs.forEach(function(log) { %>
                    <li>
                        <span class="timestamp"><%= log.timestamp %></span>
                        <span class="event"><%= log.event %></span>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </main>
</body>
</html>
