<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Adventure Logs</title>
<link rel="stylesheet" href="/website/theme.css">
<link rel="stylesheet" href="/website/tables.css">
</head>
<body bgcolor="black" text="white" link="#90c040" alink="#90c040" vlink="#90c040" style="margin:0px">

<%- include('partials/frame-header') %>

<table width="300" bgcolor="black" cellpadding="4"><tbody><tr><td class="e"><center>
<b>Adventure Logs</b><br><a href="/" class="c">Main menu</a>
</center></td></tr></tbody></table>

<br>
<table width="540" bgcolor="black" cellpadding="10"><tbody><tr><td class="e">
<center><b>Recent Activity</b> <span style="color:#9db8c3;font-size:11px;">(times shown in your local timezone)</span></center>

<% if (logs.length === 0) { %>
    <p style="text-align:center;">
        <% if (search) { %>No activity found for "<%= search %>".<% } else { %>No activity yet.<% } %>
    </p>
<% } else { %>
    <table class="rs-table"><tbody>
        <% logs.forEach(function(log) { %>
            <tr>
                <td class="log-timestamp" data-iso="<%= log.timestamp %>" style="white-space:nowrap;color:#9db8c3;"><%= log.timestamp %></td>
                <td><%= log.event %></td>
            </tr>
        <% }); %>
    </tbody></table>
<% } %>

</td></tr></tbody></table>

<br>

<table width="220" bgcolor="black" cellpadding="4"><tbody><tr><td class="b" bgcolor="#474747" background="/website/stoneback.gif"><center>
<form method="get" action="/activity" style="display:inline"><b>Search by name</b><br>
<input type="text" maxlength="12" size="14" name="search" value="<%= search %>"><br>
<input type="submit" value="Search" style="margin-top:4px">
</form></center></td></tr></tbody></table>

<%
    function pageLink(targetPage) {
        const params = new URLSearchParams();
        if (targetPage > 1) {
            params.set('page', String(targetPage));
        }
        if (search) {
            params.set('search', search);
        }
        const qs = params.toString();
        return '/activity' + (qs ? '?' + qs : '');
    }
%>
<% if (page > 1 || hasNextPage) { %>
<br>
<p style="text-align:center;">
    <% if (page > 1) { %><a class="c" href="<%= pageLink(page - 1) %>">&laquo; Newer</a><% } %>
    <% if (page > 1 && hasNextPage) { %>&nbsp;|&nbsp;<% } %>
    <% if (hasNextPage) { %><a class="c" href="<%= pageLink(page + 1) %>">Older &raquo;</a><% } %>
</p>
<% } %>

<%- include('partials/frame-footer') %>

<script>
    document.querySelectorAll('.log-timestamp').forEach(function (el) {
        var iso = el.getAttribute('data-iso');
        if (!iso) {
            return;
        }

        var formatted = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(iso));
        el.textContent = formatted;
    });
</script>

</body>
</html>
