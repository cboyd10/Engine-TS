<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Item Database</title>
<link rel="stylesheet" href="/website/theme.css">
<link rel="stylesheet" href="/website/tables.css">
<style>
.sectiontitle { text-align: left; margin: 16px 0 2px; font-size: 16px; }
.searchform { text-align: center; }
.searchform input[type="text"] { margin-top: 4px; }
.searchform input[type="submit"] { margin-top: 4px; }
.emptynote { color: #a3aa9e; padding: 8px 0; margin: 0; }
.map-link-disabled { color: #a3aa9e; }
.canvas-frame { padding: 8px; display: inline-block; }
#canvas { display: block; background: #000; }
</style>
</head>
<body bgcolor="black" text="white" link="#90c040" alink="#90c040" vlink="#90c040" style="margin:0px">

<%- include('partials/frame-header') %>

<table width="300" bgcolor="black" cellpadding="4"><tbody><tr><td class="e"><center>
<b>Item Database</b><br><a href="/" class="c">Main menu</a>
</center></td></tr></tbody></table>

<br>
<table width="280" bgcolor="black" cellpadding="4"><tbody><tr><td class="b" bgcolor="#474747" background="/website/stoneback.gif"><center>
<form class="searchform" method="get" action="/items">
<b>Search for an item</b><br>
<input type="text" name="q" maxlength="40" size="22" placeholder="e.g. snape grass" value="<%= query %>" autofocus><br>
<input type="submit" value="Search">
</form>
</center></td></tr></tbody></table>

<br>
<table width="560" bgcolor="black" cellpadding="10"><tbody><tr><td class="e" style="text-align:left;">

<% if (!results) { %>
    <p class="emptynote">Enter an item name above to search.</p>
<% } else if (results.shops.length === 0 && results.groundSpawns.length === 0) { %>
    <p class="emptynote">No shop stock or ground spawns found for "<%= query %>". (Drop-table sources aren't indexed yet.)</p>
<% } else { %>
    <div class="sectiontitle"><b>Shop Stock</b></div>
    <% if (results.shops.length === 0) { %>
        <p class="emptynote">No shop sells this item.</p>
    <% } else { %>
        <table class="rs-table">
            <thead>
                <tr>
                    <th>Area</th>
                    <th>Item</th>
                    <th>Shop</th>
                    <th>NPC</th>
                    <th class="numeric">Qty</th>
                    <th class="numeric">Price</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% results.shops.forEach(function(row) { %>
                    <tr>
                        <td><%= row.area %></td>
                        <td><%= row.item %></td>
                        <td><%= row.shop %></td>
                        <td><%= row.npcName ?? 'Unknown' %></td>
                        <td class="numeric"><%= row.quantity %></td>
                        <td class="numeric"><%= row.price %></td>
                        <td>
                            <% if (row.locations.length > 0) { %>
                                <a class="c" href="#map" onclick="focusMap(<%= row.locations[0].x %>, <%= row.locations[0].z %>); return false;">Show on Map</a>
                            <% } else { %>
                                <span class="map-link-disabled">No known location</span>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } %>

    <div class="sectiontitle"><b>Ground Spawns</b></div>
    <% if (results.groundSpawns.length === 0) { %>
        <p class="emptynote">No ground spawns found for this item.</p>
    <% } else { %>
        <table class="rs-table">
            <thead>
                <tr>
                    <th>Area</th>
                    <th>Item</th>
                    <th class="numeric">Coords</th>
                    <th class="numeric">Qty</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% results.groundSpawns.forEach(function(row) { %>
                    <tr>
                        <td><%= row.area ?? 'Unknown area' %></td>
                        <td><%= row.item %></td>
                        <td class="numeric"><%= row.x %>, <%= row.z %> (plane <%= row.level %>)</td>
                        <td class="numeric"><%= row.quantity %></td>
                        <td>
                            <a class="c" href="#map" onclick="focusMap(<%= row.x %>, <%= row.z %>); return false;">Show on Map</a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } %>

    <%
        const itemMarkers = results.groundSpawns.map(r => ({ x: r.x, z: r.z }));
        const npcMarkers = [];
        results.shops.forEach(s => s.locations.forEach(l => npcMarkers.push({ x: l.x, z: l.z })));
        const initialCenter = itemMarkers[0] || npcMarkers[0] || null;
    %>

    <div class="sectiontitle" id="map"><b>Map</b></div>
    <p class="emptynote" style="margin: 0 0 8px;">Red dots are ground spawns, yellow dots are shop npcs. Click a "Show on Map" link above to re-center.</p>
    <center>
    <div class="canvas-frame">
        <canvas id="canvas" width="860" height="560"></canvas>
    </div>
    </center>

    <script type="module">
        import { MapView } from '/mapview/mapview.js';

        const itemMarkers = <%- JSON.stringify(itemMarkers) %>;
        const npcMarkers = <%- JSON.stringify(npcMarkers) %>;
        const initialCenter = <%- JSON.stringify(initialCenter) %>;

        const mapView = new MapView();
        window.__mapView = mapView;

        window.focusMap = function (x, z) {
            window.__mapView.centerOn(x, z);
            document.getElementById('map').scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        const applyMarkers = () => {
            mapView.setMarkers(itemMarkers, npcMarkers);
            if (initialCenter) {
                mapView.centerOn(initialCenter.x, initialCenter.z);
            }
        };

        // markers/centering only take effect once maininit() has finished
        // loading worldmap.jag
        const waitForLoad = setInterval(() => {
            if (mapView.loaded) {
                clearInterval(waitForLoad);
                applyMarkers();
            }
        }, 100);
    </script>
<% } %>

</td></tr></tbody></table>
<br>

<%- include('partials/frame-footer') %>

</body>
</html>
